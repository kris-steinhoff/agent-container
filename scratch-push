#!/usr/bin/env bash
set -euo pipefail

# Push the shared scratch directory from this Mac up to the container:
# ./agent_scratch/ -> agent-container:scratch/. The cloud path has no
# bind-mount, so this rsync is how you hand files to an agent (and scratch-pull
# is how you get its artifacts back). Pass an optional path (relative to
# agent_scratch/) to sync just one file or subdir.

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
local_dir="$here/agent_scratch"

if [ ! -d "$local_dir" ]; then
    echo "scratch-push: $local_dir does not exist — create it first: mkdir -p '$local_dir'" >&2
    exit 1
fi

sub="${1:-}"
if [ -n "$sub" ]; then
    rsync -az --partial -e ssh "$local_dir/${sub}" "agent-container:scratch/"
else
    rsync -az --partial -e ssh "$local_dir/" "agent-container:scratch/"
fi
