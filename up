#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["boto3[crt]"]
# ///
"""Bring the agent-container up locally (Docker Compose) or in the cloud (Fargate).

    ./up                     ==  ./up docker           (idempotent local up -d)
    ./up docker [--restart] [--build]
    ./up cloud  [--restart] [--build] [--stop] [--cidr CIDR]

Both subcommands (re)generate the whole `ssh_config` (gitignored, Include'd from
~/.ssh/config once): a static `agent-container-docker` alias for the local
container and an `agent-container-cloud` alias for the Fargate task. The cloud
path runs a single standalone task (not a Service): launch it with `./up cloud`,
it stops itself when idle (task STOPPED -> $0), and `./up cloud` again brings it
back. The task's public IP changes each start, so `./up cloud` resolves it and
writes it into the cloud alias; the persisted EFS host keys keep the host key
stable, so `herdr --remote agent-container-cloud` works like the local setup.

Cloud config is read from `.up.toml`, which `terraform apply` in ./terraform
renders — `./up cloud` never shells out to terraform (or needs it installed).
Change config by editing terraform/terraform.tfvars and re-running apply. Each
key can still be overridden by the AGENT_* env var in CONFIG_ENV below, a rarely
needed escape hatch.
"""

import argparse
import base64
import os
import re
import socket
import subprocess
import sys
import time
import tomllib
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent
STARTED_BY = "up-cloud"  # tags the task so this script can find "the" one
UP_TOML = REPO / ".up.toml"
IMPLICIT_PROFILE = "agent-container"  # profile name tried when nothing else is set

# .up.toml key -> AGENT_* env var that overrides it. Escape hatch for pointing
# ./up cloud at a hand-built stack, or a value terraform hasn't re-rendered yet.
CONFIG_ENV = {
    "region": "AGENT_REGION",
    "cluster_arn": "AGENT_CLUSTER_ARN",
    "task_definition_family": "AGENT_TASK_DEFINITION_FAMILY",
    "task_security_group_id": "AGENT_TASK_SG_ID",
    "ssh_security_group_id": "AGENT_SSH_SG_ID",
    "subnet_id": "AGENT_SUBNET_ID",
    "log_group_name": "AGENT_LOG_GROUP",
    "ecr_repository_url": "AGENT_ECR_REPOSITORY_URL",
    "aws_profile": "AGENT_AWS_PROFILE",
}

# Keys ./up cloud can't run without (ecr_repository_url is only needed for
# --build, so it's checked there instead).
REQUIRED_KEYS = (
    "region", "cluster_arn", "task_definition_family", "subnet_id",
    "task_security_group_id", "ssh_security_group_id", "log_group_name",
)


def run(cmd, **kwargs):
    """Run a command, echoing it first so the script stays legible."""
    print("+ " + " ".join(cmd))
    return subprocess.run(cmd, check=True, **kwargs)


# ---------------------------------------------------------------------------
# Local Docker path.
# ---------------------------------------------------------------------------
def cmd_docker(args):
    env = os.environ.copy()
    compose = ["docker", "compose", "up", "-d"]
    if args.build:
        # Fresh cache-gate token so the fast-moving tools reinstall; today's
        # `./up` behavior. --build implies a recreate.
        env["TOOLS_REFRESH"] = str(int(time.time()))
        compose += ["--build", "--force-recreate"]
    elif args.restart:
        compose += ["--force-recreate"]
    run(compose, cwd=REPO, env=env)
    # Regenerate ssh_config (keeping any current cloud IP) so the docker alias
    # is present, then point the user at it.
    write_ssh_config()
    print()
    print("Attach with:")
    print("    herdr --remote agent-container-docker")


# ---------------------------------------------------------------------------
# Cloud config: .up.toml (rendered by `terraform apply`) + AGENT_* overrides.
# ---------------------------------------------------------------------------
def load_config():
    if not UP_TOML.exists():
        sys.exit(f"{UP_TOML.name} not found — run `terraform -chdir=terraform apply` "
                 "first (it generates .up.toml).")
    with UP_TOML.open("rb") as fh:
        cfg = tomllib.load(fh)
    for key, envvar in CONFIG_ENV.items():
        override = os.environ.get(envvar)
        if override:
            cfg[key] = override
    missing = [k for k in REQUIRED_KEYS if not cfg.get(k)]
    if missing:
        sys.exit(f"{UP_TOML.name} is missing keys: {', '.join(missing)}. "
                 "Re-run `terraform -chdir=terraform apply`.")
    return cfg


def resolve_profile(args, cfg):
    """AWS profile for `./up cloud`, first of these that's set:
      1. --profile NAME
      2. AWS_PROFILE already in the environment
      3. .up.toml `aws_profile` (AGENT_AWS_PROFILE overrides that key)
      4. the literal "agent-container", only if that profile exists
      5. otherwise ambient credentials (AWS_PROFILE left unset)
    An explicitly named profile (1 or 3) that doesn't exist is fatal; the
    implicit default (4) just falls through to ambient."""
    import botocore.session
    available = set(botocore.session.Session().available_profiles)

    if args.profile:
        if args.profile not in available:
            sys.exit(f"AWS profile {args.profile!r} (--profile) not found in ~/.aws.")
        return args.profile

    if os.environ.get("AWS_PROFILE"):
        return os.environ["AWS_PROFILE"]

    named = (cfg.get("aws_profile") or "").strip()
    if named:
        if named not in available:
            sys.exit(f"AWS profile {named!r} (.up.toml / AGENT_AWS_PROFILE) not found in ~/.aws.")
        return named

    return IMPLICIT_PROFILE if IMPLICIT_PROFILE in available else None


def clients(cfg):
    import boto3
    reg = cfg["region"]
    return boto3.client("ecs", region_name=reg), boto3.client("ec2", region_name=reg)


# ClientError codes that mean "your credentials are stale", not "you lack access".
AWS_REAUTH_ERROR_CODES = {
    "ExpiredToken", "ExpiredTokenException", "RequestExpired",
    "InvalidClientTokenId", "UnrecognizedClientException",
}


def is_aws_reauth_error(exc):
    """True if exc is botocore telling us the session is expired / invalid and
    the fix is `aws login` — as opposed to a permissions or resource error."""
    from botocore import exceptions as be
    names = ("LoginRefreshRequired", "LoginRequiredError", "TokenRetrievalError",
             "SSOTokenLoadError", "UnauthorizedSSOTokenError", "NoCredentialsError",
             "CredentialRetrievalError")
    reauth_types = tuple(t for t in (getattr(be, n, None) for n in names) if t)
    if isinstance(exc, reauth_types):
        return True
    if isinstance(exc, be.ClientError):
        return exc.response.get("Error", {}).get("Code") in AWS_REAUTH_ERROR_CODES
    return False


# ---------------------------------------------------------------------------
# Task lifecycle.
# ---------------------------------------------------------------------------
def find_task(ecs, cluster):
    """The startedBy=up-cloud task, or None. Prefers the desired-RUNNING one;
    falls back to a still-STOPPING task so we can wait it out."""
    arns = ecs.list_tasks(cluster=cluster, startedBy=STARTED_BY,
                          desiredStatus="RUNNING")["taskArns"]
    if not arns:
        arns = ecs.list_tasks(cluster=cluster, startedBy=STARTED_BY,
                              desiredStatus="STOPPED")["taskArns"]
    if not arns:
        return None
    tasks = ecs.describe_tasks(cluster=cluster, tasks=arns)["tasks"]
    live = [t for t in tasks if t["lastStatus"] != "STOPPED"]
    if not live:
        return None
    live.sort(key=lambda t: t["createdAt"], reverse=True)
    return live[0]


def start_task(ecs, cfg):
    print("Launching a new Fargate task...")
    resp = ecs.run_task(
        cluster=cfg["cluster_arn"],
        taskDefinition=cfg["task_definition_family"],
        launchType="FARGATE",
        count=1,
        startedBy=STARTED_BY,
        networkConfiguration={"awsvpcConfiguration": {
            "subnets": [cfg["subnet_id"]],
            "securityGroups": [cfg["task_security_group_id"], cfg["ssh_security_group_id"]],
            "assignPublicIp": "ENABLED",
        }},
    )
    failures = resp.get("failures") or []
    if failures:
        sys.exit(f"run_task failed: {failures}")
    arn = resp["tasks"][0]["taskArn"]
    print(f"  task {arn.split('/')[-1]}")
    return arn


def wait_running(ecs, cluster, task_arn):
    print("Waiting for the task to reach RUNNING...")
    ecs.get_waiter("tasks_running").wait(
        cluster=cluster, tasks=[task_arn], WaiterConfig={"Delay": 6, "MaxAttempts": 50})
    return ecs.describe_tasks(cluster=cluster, tasks=[task_arn])["tasks"][0]


def wait_stopped(ecs, cluster, task_arn):
    print("Waiting for the task to reach STOPPED...")
    ecs.get_waiter("tasks_stopped").wait(
        cluster=cluster, tasks=[task_arn], WaiterConfig={"Delay": 6, "MaxAttempts": 60})


def eni_of_task(task):
    for att in task.get("attachments", []):
        if att.get("type") == "ElasticNetworkInterface":
            for detail in att.get("details", []):
                if detail.get("name") == "networkInterfaceId":
                    return detail.get("value")
    return None


# ---------------------------------------------------------------------------
# Side-effect reconciliation: resolve the public IP + the single tcp/22 rule.
# ---------------------------------------------------------------------------
def public_ip_of_eni(ec2, eni_id):
    eni = ec2.describe_network_interfaces(NetworkInterfaceIds=[eni_id])["NetworkInterfaces"][0]
    ip = eni.get("Association", {}).get("PublicIp")
    if not ip:
        sys.exit(f"Task ENI {eni_id} has no public IP; is assignPublicIp ENABLED on the task?")
    return ip


def reconcile_sg(ec2, sg_id, cidr):
    """Ensure the ssh SG has exactly one tcp/22 ingress rule, for `cidr`. IPv4
    only; no-op when it already matches, otherwise revoke all tcp/22 and
    authorize the desired one."""
    sg = ec2.describe_security_groups(GroupIds=[sg_id])["SecurityGroups"][0]
    perms22 = [p for p in sg["IpPermissions"]
               if p.get("IpProtocol") == "tcp" and p.get("FromPort") == 22 and p.get("ToPort") == 22]
    current = sorted(r["CidrIp"] for p in perms22 for r in p.get("IpRanges", []))
    has_v6 = any(p.get("Ipv6Ranges") for p in perms22)
    if current == [cidr] and not has_v6:
        print(f"SSH ingress already allows exactly {cidr}.")
        return
    revoke = []
    for p in perms22:
        entry = {"IpProtocol": "tcp", "FromPort": 22, "ToPort": 22}
        if p.get("IpRanges"):
            entry["IpRanges"] = p["IpRanges"]
        if p.get("Ipv6Ranges"):
            entry["Ipv6Ranges"] = p["Ipv6Ranges"]
        if len(entry) > 3:
            revoke.append(entry)
    if revoke:
        print("Revoking existing tcp/22 ingress...")
        ec2.revoke_security_group_ingress(GroupId=sg_id, IpPermissions=revoke)
    print(f"Authorizing tcp/22 ingress from {cidr}...")
    ec2.authorize_security_group_ingress(GroupId=sg_id, IpPermissions=[{
        "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22,
        "IpRanges": [{"CidrIp": cidr, "Description": "up cloud managed"}],
    }])


def desired_cidr(cidr_arg):
    if cidr_arg:
        return cidr_arg
    with urllib.request.urlopen("https://checkip.amazonaws.com", timeout=10) as resp:
        ip = resp.read().decode().strip()
    return f"{ip}/32"


def wait_port(host, port=22, timeout=180):
    print(f"Polling {host}:{port} for SSH (up to {timeout}s)...")
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=5):
                print("Port 22 is open.")
                return True
        except OSError:
            time.sleep(3)
    return False


def build_and_push(cfg):
    repo = cfg.get("ecr_repository_url")
    if not repo:
        sys.exit("ecr_repository_url unavailable (terraform output / $AGENT_ECR_REPOSITORY_URL); "
                 "cannot --build.")
    import boto3
    registry = repo.split("/")[0]
    print("Logging in to ECR...")
    token = boto3.client("ecr", region_name=cfg["region"]).get_authorization_token()
    raw = token["authorizationData"][0]["authorizationToken"]
    user, password = base64.b64decode(raw).decode().split(":", 1)
    subprocess.run(["docker", "login", "--username", user, "--password-stdin", registry],
                   input=password, text=True, check=True)
    run(["docker", "buildx", "build", "--platform", "linux/arm64",
         "--build-arg", "AGENT_UID=1001", "-t", f"{repo}:latest", "--push", "."], cwd=REPO)


# The whole ssh_config is owned by ./up (gitignored, Include'd from
# ~/.ssh/config). agent-container-docker is always static; only the cloud
# alias's HostName is dynamic — the cloud task's IP changes each start, and
# CheckHostIP no + accept-new keep known_hosts stable (the EFS-persisted host
# key is constant, so matching is on the alias, not the address).
SSH_CONFIG_TEMPLATE = """\
Host agent-container-docker
    HostName localhost
    Port 2222
    User agent
    ForwardAgent no

Host agent-container-cloud
    HostName {cloud_ip}
    Port 22
    User agent
    ForwardAgent no
    CheckHostIP no
    StrictHostKeyChecking accept-new
"""

SSH_CONFIG_PATH = REPO / "ssh_config"


def existing_cloud_ip():
    """The HostName from the current ssh_config's agent-container-cloud stanza,
    or None — used to preserve it when ./up docker rewrites the file."""
    try:
        text = SSH_CONFIG_PATH.read_text()
    except OSError:
        return None
    match = re.search(
        r"^Host\s+agent-container-cloud\s*$.*?^\s*HostName\s+(\S+)",
        text, re.MULTILINE | re.DOTALL)
    return match.group(1) if match else None


def write_ssh_config(cloud_ip=None):
    """Overwrite the whole ssh_config from the template. With a cloud_ip, point
    the cloud alias at it; without one (the ./up docker case) keep whatever
    cloud IP is already on disk, falling back to 0.0.0.0 when there's no file."""
    if cloud_ip is None:
        cloud_ip = existing_cloud_ip() or "0.0.0.0"
    SSH_CONFIG_PATH.write_text(SSH_CONFIG_TEMPLATE.format(cloud_ip=cloud_ip))
    print(f"Wrote {SSH_CONFIG_PATH}")
    return SSH_CONFIG_PATH


def print_ready():
    print()
    print("Attach with:")
    print("    herdr --remote agent-container-cloud")


def finish(ecs, ec2, cfg, task):
    """Resolve the public IP, fix the SG rule, wait for SSH, point the cloud
    SSH alias at it, print the herdr line."""
    eni = eni_of_task(task)
    if not eni:
        sys.exit("Could not find the task's ENI; cannot resolve its public IP.")
    ip = public_ip_of_eni(ec2, eni)
    reconcile_sg(ec2, cfg["ssh_security_group_id"], cfg["_cidr"])
    write_ssh_config(ip)
    if not wait_port(ip):
        print(f"Task is RUNNING at {ip}, but port 22 did not open in time.")
        print("Check the container logs in CloudWatch group:", cfg["log_group_name"])
        return
    print_ready()


# ---------------------------------------------------------------------------
# Cloud path.
# ---------------------------------------------------------------------------
def cmd_cloud(args):
    cfg = load_config()

    # Select the profile before the first boto3 client is created.
    profile = resolve_profile(args, cfg)
    if profile:
        os.environ["AWS_PROFILE"] = profile

    import boto3
    sts = boto3.client("sts", region_name=cfg["region"])
    ident = sts.get_caller_identity()
    print(f'Acting as: {ident["Arn"]}  (profile: {profile or "ambient"})')

    ecs, ec2 = clients(cfg)
    cluster = cfg["cluster_arn"]

    if args.stop:
        task = find_task(ecs, cluster)
        if task and task["lastStatus"] in ("PROVISIONING", "PENDING", "RUNNING", "STOPPING"):
            name = task["taskArn"].split("/")[-1]
            print(f"Stopping task {name} ({task['lastStatus']})...")
            ecs.stop_task(cluster=cluster, task=task["taskArn"], reason="up cloud --stop")
        else:
            print("No running task to stop.")
        return

    if args.build:
        build_and_push(cfg)
        args.restart = True

    cfg["_cidr"] = desired_cidr(args.cidr)

    task = find_task(ecs, cluster)
    status = task["lastStatus"] if task else None

    # --restart: tear down a live task first, then fall through to a fresh run.
    if args.restart and status in ("PROVISIONING", "PENDING", "RUNNING"):
        print("--restart: stopping the current task (this kills the in-container herdr server)...")
        ecs.stop_task(cluster=cluster, task=task["taskArn"], reason="up cloud --restart")
        wait_stopped(ecs, cluster, task["taskArn"])
        task, status = None, None

    if status == "STOPPING":
        wait_stopped(ecs, cluster, task["taskArn"])
        task, status = None, None

    if status in ("PROVISIONING", "PENDING"):
        task = wait_running(ecs, cluster, task["taskArn"])
        status = "RUNNING"

    if status == "RUNNING":
        # Already up: reconcile side-effects only, don't disrupt it.
        finish(ecs, ec2, cfg, task)
        return

    # none / STOPPED -> launch fresh.
    arn = start_task(ecs, cfg)
    task = wait_running(ecs, cluster, arn)
    finish(ecs, ec2, cfg, task)


def main():
    parser = argparse.ArgumentParser(
        prog="up",
        description="Bring the agent-container up locally (Docker) or in the cloud (Fargate).")
    sub = parser.add_subparsers(dest="target")

    d = sub.add_parser("docker", help="Local Docker Compose container (the default).")
    d.add_argument("--restart", action="store_true", help="Force-recreate the container.")
    d.add_argument("--build", action="store_true",
                   help="Rebuild the image (fresh TOOLS_REFRESH) and recreate. Implies --restart.")
    d.set_defaults(func=cmd_docker)

    c = sub.add_parser("cloud", help="Single standalone Fargate task (scale-to-zero).")
    c.add_argument("--restart", action="store_true",
                   help="Stop the running task and launch a fresh one (kills the in-container herdr server).")
    c.add_argument("--build", action="store_true",
                   help="Build the arm64 image, push to ECR, then restart. Implies --restart.")
    c.add_argument("--stop", action="store_true", help="Stop the running task and exit (scale to zero).")
    c.add_argument("--cidr", help="CIDR allowed to reach port 22 (default: your public IP /32).")
    c.add_argument("--profile", help="AWS profile to use (default: AWS_PROFILE, else .up.toml aws_profile, "
                                     "else 'agent-container' if it exists).")
    c.set_defaults(func=cmd_cloud)

    args = parser.parse_args()
    if args.target is None:
        args = parser.parse_args(["docker"])  # `./up` == `./up docker`
    try:
        args.func(args)
    except Exception as exc:  # noqa: BLE001 - narrowed immediately below
        if is_aws_reauth_error(exc):
            sys.exit(f"\nAWS session expired or invalid ({type(exc).__name__}).\n"
                     "Run  aws login  and retry.\n")
        raise


if __name__ == "__main__":
    main()
