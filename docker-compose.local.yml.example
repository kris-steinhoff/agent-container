# Per-machine override, not shared via git. Copy this to
# docker-compose.local.yml (already gitignored) and adjust the path.
#
# Bind-mounts a shared scratch directory at /home/agent/scratch, alongside
# (not replacing) the agent_home named volume — a handoff space where an
# agent can leave a draft artifact (a drawio diagram, a screenshot, a
# document for review) as a real file you can open from the desktop, and
# where you can leave one for the agent. Everything else (dotfiles, shell
# history, tool caches, project checkouts) stays in agent_home as normal.
#
# Any absolute path works; ./agent_scratch (next to the repo) is gitignored.
# See README.md#shared-scratch-directory for how to wire this file in
# automatically via direnv, and why AGENT_UID matters here.
services:
  agent:
    volumes:
      - ./agent_scratch:/home/agent/scratch
